  <data key="d10">1</data>
  <data key="d11">아이유</data>
  <data key="d12">음반 발매 일주일 전인 2009년 4월 17일, KBS 《뮤직뱅크》에서 타이틀곡 〈Boo〉를 처음 선보였다.</data>
</edge>
<edge source="artist:아이유" target="song:있잖아(rockver.)" id="0">
  <data key="d6">PERFORMED</data>
