  <data key="d10">1</data>
  <data key="d11">에픽하이</data>
  <data key="d12">타이틀 곡은 "I Remember"였는데, 타이틀 곡과 음반 모두 대중적인 면과 상업적인 측면에서는 성공하지 못하였다.</data>
</edge>
<edge source="album:highsociety" target="era:2000s" id="0">
  <data key="d6">RELEASED_IN</data>
