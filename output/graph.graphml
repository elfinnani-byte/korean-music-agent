  <data key="d8">llm</data>
  <data key="d9">0.8</data>
  <data key="d10">1</data>
  <data key="d11">015B</data>
  <data key="d12">015B는 2012년에도 'Let me go'와 '짝', '80' 을 디지털 싱글로 발매하였다.</data>
</edge>
